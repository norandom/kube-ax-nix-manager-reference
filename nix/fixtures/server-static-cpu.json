{
  "admin": {
    "sshKeys": [
      "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIFixtureKeyFixtureKeyFixtureKeyFixtureKey fixture"
    ],
    "user": "ops"
  },
  "bootMode": "bios",
  "disk": "/dev/sda",
  "diskLayout": {
    "containerd": "35G",
    "root": "20G",
    "storage": "30G"
  },
  "hostName": "kube-01",
  "k3s": {
    "ateOnContainerd": true,
    "disable": [
      "traefik"
    ],
    "entryPoint": true,
    "flannelBackend": "host-gw",
    "kubelet": {
      "cpuManagerPolicy": "static",
      "evictionHard": {
        "imagefs.available": "15%",
        "memory.available": "256Mi",
        "nodefs.available": "10%"
      },
      "evictionSoft": {
        "memory.available": "512Mi"
      },
      "evictionSoftGracePeriod": {
        "memory.available": "1m30s"
      },
      "imageGcHigh": 80,
      "imageGcLow": 60,
      "kernelMemcgNotification": true,
      "kubeReserved": {
        "cpu": "200m",
        "memory": "512Mi"
      },
      "reservedCpus": "0",
      "swapBehavior": "LimitedSwap",
      "systemReserved": {
        "cpu": "200m",
        "memory": "256Mi"
      }
    },
    "labels": {
      "svccontroller.k3s.cattle.io/enablelb": "true",
      "topology.kubernetes.io/zone": "kube-01"
    },
    "nodeIp": "10.0.0.63",
    "role": "server",
    "serverAddr": null,
    "tokenFile": "/var/lib/k3s-secrets/token",
    "traefikReplicas": 1
  },
  "kvm": "intel",
  "network": {
    "address": "10.0.0.63/24",
    "dns": [
      "10.0.0.1"
    ],
    "gateway": "10.0.0.1",
    "mac": "bc:24:11:00:00:01"
  },
  "phase": "k3s",
  "schema": 1,
  "tuning": {
    "cpuMitigations": "off",
    "cpuidleHaltpoll": true,
    "kernelPreempt": "voluntary",
    "ksm": true,
    "nofile": {
      "hard": 524288,
      "soft": 65536
    },
    "softLockupWatchdog": true,
    "swapMode": "none",
    "sysctl": {
      "vm.swappiness": 60
    },
    "zramAlgorithm": "lz4",
    "zramPercent": 25,
    "zswapSwapfileGb": 4
  }
}
